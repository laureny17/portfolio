# Copy to .env.local and fill in. Also add these to the Vercel project's env vars.
# Spotify app: https://developer.spotify.com/dashboard (redirect URI http://127.0.0.1:8888/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From: node --env-file=.env.local scripts/spotify-auth.mjs
SPOTIFY_REFRESH_TOKEN=
